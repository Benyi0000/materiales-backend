# -----------------------------------------------------------------------------
# Configuración del Entorno de E-commerce de Materiales
# Copie este archivo a .env y configure sus credenciales locales o de producción.
# -----------------------------------------------------------------------------

SECRET_KEY=django-insecure-materiales-construccion-mvp-2026-key
DEBUG=True
ALLOWED_HOSTS=*

# Base de Datos (PostgreSQL + pgvector local mediante Docker)
# Esta URL asume que usaste el archivo docker-compose.yml incluido en este repositorio.
DATABASE_URL=postgresql://craftiar_user:craftiar_password@localhost:5432/craftiar_db

# Broker de Tareas Celery (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Autenticación con Google (OAuth 2.0)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# APIs de Inteligencia Artificial (Google Gemini)
GOOGLE_API_KEY=tu_google_api_key_aqui
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
